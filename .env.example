# ============ PLANTILLA: copia este archivo como ".env" ============

# Token del bot (lo obtienes de @BotFather en Telegram).
# NUNCA subas el .env a GitHub.
TELEGRAM_TOKEN=aqui_va_el_token

# El/Los DUEÑO(S): ven todo el taller (incluido el desglose por mecánico).
# Formato "ID" o "ID:Nombre". Varios separados por coma.
ADMIN_IDS=9136002456

# MECÁNICOS: cada uno SOLO ve sus propios trabajos y ganancias.
# Obligatorio formato ID:Nombre, separados por coma:
#   MECHANICS=1122334455:Pedro,5566778899:Juan
# Para obtener el ID: la persona escribe a @userinfobot y le responde con su Id.
MECHANICS=
