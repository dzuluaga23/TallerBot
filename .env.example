# ============ PLANTILLA: copia este archivo como ".env" ============

# Token del bot (lo obtienes de @BotFather en Telegram).
# NUNCA subas el .env a GitHub.
TELEGRAM_TOKEN=aqui_va_el_token

# Códigos de venta: cada uno permite crear UN solo taller (un solo uso).
# El comprador lo usa: /nuevotaller CODIGO NombreDelTaller
CODIGOS_TALLER=

# Desarrollador (opcional): tu ID de Telegram habilita /talleres y /cerrartaller ID
DESARROLLO_ID=

# ── RESPALDOS A GITHUB (solo sirven al correr en Render) ───────────────────
# Repo PRIVADO donde respaldo.py guarda taller.db + un token con permiso
# contents:write sobre ese repo. En tu PC puedes dejarlo vacio.
#   GITHUB_RES_REPO=usuario/respaldo-taller
#   GITHUB_TOKEN=github_pat_...
#   RESPALDO_MINUTOS=10
GITHUB_RES_REPO=
GITHUB_TOKEN=
RESPALDO_MINUTOS=10

# Hora del taller: en la nube sin esto "hoy"/"mes" corren en UTC (Bogota = UTC-5)
#   TZ=America/Bogota
TZ=America/Bogota
