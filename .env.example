# ============ PLANTILLA: copia este archivo como ".env" ============
# (clic derecho al archivo -> Copiar -> Pegar en la misma carpeta ->
#  renombrar el nuevo a ".env" de PF, con punto al inicio)

# Token del bot (lo obtienes de @BotFather en Telegram).
# Nunca pegues este archivo ni el token en GitHub publico.
TELEGRAM_TOKEN=aqui_va_el_token

# ── QUIEN PUEDE USAR EL BOT (lista blanca) ─────────────────
# Solo los IDs que aparezcan aqui pueden escribirle al bot.
# Varios IDs separados por coma. Ejemplo con 3 usuarios:
#
#   AUTHORIZED_IDS=9136002456,123456789,555444333
#
# Como conseguir un ID: la persona escribe algo a @userinfobot
# en Telegram y ese bot le responde con su "Id".
AUTHORIZED_IDS=tu_id_aqui
